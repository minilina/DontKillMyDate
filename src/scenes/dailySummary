import Phaser from "phaser";
import GameState from "../state/GameState.js";

export default class DailySummary extends Phaser.Scene {
  constructor() {
    super({ key: "dailySummary" });
  }

  create() {
    const centerX = this.scale.width / 2;
    const centerY = this.scale.height / 2;

    // 1. CONFIGURACIÓN VISUAL (Pergamino grande, elementos pequeños)
    const bgScale = 3;
    const iconScale = 1.6; // Tamaño pequeño solicitado
    const iconSpacing = 65; // Espaciado para iconos pequeños

    // 2. FONDO
    this.add.image(centerX, centerY, "resumenBg").setScale(bgScale);

    const stats = GameState.dailyStats;
    const titleColor = "#3e2723";
    const textColor = "#2b1d10";

    this.add
      .text(centerX, centerY - 140, `DÍA ${GameState.currentDay} FINALIZADO`, {
        fontFamily: "VT323, monospace",
        fontSize: "42px",
        color: titleColor,
        fontWeight: "bold",
      })
      .setOrigin(0.5);

    this.add
      .text(centerX, centerY - 85, "Desempeño Alquímico", {
        fontFamily: "VT323, monospace",
        fontSize: "26px",
        color: textColor,
      })
      .setOrigin(0.5);

    this.drawIconRow(
      centerX,
      centerY - 45,
      "estrella",
      GameState.getDailyStars(),
      iconScale,
      iconSpacing,
    );

    const sign = stats.repChange >= 0 ? "+" : "";
    const repLabel = `Reputación Total: ${GameState.reputation} (${sign}${stats.repChange})`;

    this.add
      .text(centerX, centerY + 25, repLabel, {
        fontFamily: "VT323, monospace",
        fontSize: "26px",
        color: titleColor,
      })
      .setOrigin(0.5);

    this.drawIconRow(
      centerX,
      centerY + 65,
      "corazon",
      GameState.getReputationHearts(),
      iconScale,
      iconSpacing,
    );

    const consejos = [
      "Investiga todo lo que puedas, el bosque aguarda secretos.",
      "El tiempo vuela fuera, aprovecha cada paso en el exterior.",
      "Tu reputación determina tu futuro, cuida cada poción.",
      "Explora cada rincón fuera de la casa antes de marcharte.",,
    ];

    const consejoDelDia =
      consejos[(GameState.currentDay - 1) % consejos.length];

    const tipText = this.add
      .text(centerX, centerY + 140, "", {
        fontFamily: "VT323, monospace",
        fontSize: "26px",
        color: "#5d4037",
        align: "center",
        fontStyle: "italic",
        wordWrap: { width: 480 },
      })
      .setOrigin(0.5);

    // Animación de escritura
    let currentChar = 0;
    this.time.addEvent({
      delay: 45,
      callback: () => {
        tipText.text += consejoDelDia[currentChar];
        currentChar++;
      },
      repeat: consejoDelDia.length - 1,
    });

    // Resaltado visual del consejo (suave latido)
    this.tweens.add({
      targets: tipText,
      alpha: { from: 0.7, to: 1 },
      scale: { from: 1, to: 1.03 },
      duration: 1800,
      yoyo: true,
      repeat: -1,
      ease: "Sine.easeInOut",
    });

    // --- INTERACCIÓN ---
    // Toda la pantalla detecta el clic para avanzar sin necesidad de texto
    this.input.once("pointerdown", () => {
      GameState.advanceDay();
      this.scene.start("house");
    });
  }

  /**
   * Dibuja una fila de 5 iconos ajustable.
   */
  drawIconRow(x, y, spriteKey, activeCount, scale, spacing) {
    const startX = x - spacing * 2;

    for (let i = 0; i < 5; i++) {
      const icon = this.add
        .image(startX + i * spacing, y, spriteKey)
        .setScale(scale);

      if (i >= activeCount) {
        // Iconos apagados: Oscuros y con mucha transparencia
        icon.setTint(0x000000);
        icon.setAlpha(0.2);
      }
    }
  }
}
